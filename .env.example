# App de API de Strava: https://www.strava.com/settings/api
# "Authorization Callback Domain": localhost (y el dominio de producción en Coolify)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Clave para firmar las cookies de sesión (32+ caracteres). Obligatoria en producción;
# en desarrollo, si falta, se genera una y se guarda en la base de datos.
# Generar: openssl rand -hex 32
SESSION_SECRET=
